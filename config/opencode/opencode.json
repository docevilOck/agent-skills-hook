{
  "$schema": "https://opencode.ai/config.json",
  "model": "rayplus/gpt-5.4",
  "small_model": "rayplus/gpt-5.4-mini",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    "context-mode"
  ],
  "mcp": {
    "crg": {
      "type": "stdio",
      "command": "code-review-graph",
      "args": [
        "serve",
        "--tools",
        "get_minimal_context_tool,get_review_context_tool,query_graph_tool"
      ],
      "enabled": true
    }
  }
}

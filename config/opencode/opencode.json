{
  "$schema": "https://opencode.ai/config.json",
  "model": "rayplus/gpt-5.4",
  "small_model": "rayplus/gpt-5.4-mini",
  "default_agent": "build",
  "mcp": {
    "codegraph": {
      "type": "local",
      "enabled": true,
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "timeout": 60000
    },
    "semble": {
      "type": "local",
      "enabled": true,
      "command": [
        "semble",
        "mcp"
      ],
      "timeout": 60000
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    "context-mode",
    "opencode-goal-plugin"
  ]
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "rayplus/gpt-5.4",
  "small_model": "rayplus/gpt-5.4-mini",
  "default_agent": "build",
  "mcp": {
    "semble": {
      "type": "local",
      "enabled": true,
      "command": [
        "semble"
      ],
      "environment": {
        "HF_HUB_DISABLE_SYMLINKS": "1",
        "HF_HUB_DISABLE_SYMLINKS_WARNING": "1"
      },
      "timeout": 60000
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-pty"
  ]
}
